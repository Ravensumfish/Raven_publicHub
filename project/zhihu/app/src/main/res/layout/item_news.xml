<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="5dp">


    <ImageView
        android:id="@+id/image_news"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginRight="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/title_news"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:text="title"
        android:textSize="30dp"
        app:layout_constraintBottom_toTopOf="@id/author_news"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="@+id/author_news"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/author_news"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:maxLines="1"
        android:text="作者 ·"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent" />

    <TextView
        android:id="@+id/author_name_news"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:text="author"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/author_news"
        app:layout_constraintLeft_toRightOf="@id/author_news" />
</androidx.constraintlayout.widget.ConstraintLayout>