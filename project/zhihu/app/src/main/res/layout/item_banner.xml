<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/image_banner"
        android:src="@mipmap/ic_launcher"
        android:scaleType="centerCrop"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:layout_width="match_parent"
        android:layout_height="115dp"
        android:alpha="0.24"
        android:elevation="5dp"
        android:src="@color/black"
        app:layout_constraintBottom_toBottomOf="@+id/image_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/image_banner" />

    <TextView
        android:id="@+id/title_banner"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/white"
        android:padding="5dp"
        android:elevation="5dp"
        android:text="title"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@id/author_name_banner"
        app:layout_constraintLeft_toLeftOf="@id/image_banner"
        app:layout_constraintStart_toStartOf="@+id/author_name_banner" />

    <TextView
        android:id="@+id/author_name_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="21dp"
        android:layout_marginBottom="10dp"
        android:textColor="@color/white"
        android:maxLines="1"
        android:padding="5dp"
        android:elevation="5dp"
        android:text="作者"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/image_banner"
        app:layout_constraintLeft_toLeftOf="@id/image_banner"
        app:layout_constraintStart_toStartOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>